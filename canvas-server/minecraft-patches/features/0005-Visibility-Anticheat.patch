+    // Canvas start - visibility anticheat
+    /**
+     * Sends a packet that wasn't ready when it was queued, followed by its extra packets, which are only collected
+     * once the packet is ready.
+     */
+    private static final class DeferredExtraPacketsSendAction extends WrappedConsumer {
+        private final Packet<?> packet;
+
+        private DeferredExtraPacketsSendAction(final Packet<?> packet, @Nullable final ChannelFutureListener channelFutureListener, final boolean flush) {
+            super(connection -> {
+                final java.util.List<Packet<?>> extraPackets = InnerUtil.buildExtraPackets(packet);
+                if (extraPackets == null || extraPackets.isEmpty()) {
+                    connection.sendPacket(packet, channelFutureListener, flush);
+                    return;
+                }
+                connection.sendPacket(packet, null, false); // Delay the future listener until the end of the extra packets
+                for (int i = 0, len = extraPackets.size(); i < len;) {
+                    final Packet<?> extraPacket = extraPackets.get(i);
+                    final boolean end = ++i == len;
+                    connection.sendPacket(extraPacket, end ? channelFutureListener : null, end); // Append listener to the end
+                }
+            });
+            this.packet = packet;
+        }
+    }
+    // Canvas end - visibility anticheat
     // Paper end - Optimize network
 }

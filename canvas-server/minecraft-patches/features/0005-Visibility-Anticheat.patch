     // Paper end - Multi Block Change API
+    // Canvas start - visibility anticheat
+    private ClientboundSectionBlocksUpdatePacket(final SectionPos sectionPos, final short[] positions, final BlockState[] states) {
+        this.sectionPos = sectionPos;
+        this.positions = positions;
+        this.states = states;
+    }
+
+    /**
+     * @return this packet if the player may see every change, a copy without the hidden changes, or {@code null} if
+     * all changes are hidden
+     */
+    public @org.jspecify.annotations.Nullable ClientboundSectionBlocksUpdatePacket canvas$filter(final io.canvasmc.canvas.anticheat.PlayerVisibility visibility) {
+        final int minX = this.sectionPos.minBlockX();
+        final int minY = this.sectionPos.minBlockY();
+        final int minZ = this.sectionPos.minBlockZ();
+        short[] positions = null;
+        BlockState[] states = null;
+        int count = 0;
+        for (int i = 0; i < this.positions.length; ++i) {
+            final short packed = this.positions[i];
+            final boolean hidden = visibility.isBlockHidden(
+                minX + SectionPos.sectionRelativeX(packed), minY + SectionPos.sectionRelativeY(packed), minZ + SectionPos.sectionRelativeZ(packed), this.states[i]
+            );
+            if (hidden && positions == null) {
+                positions = java.util.Arrays.copyOf(this.positions, this.positions.length);
+                states = java.util.Arrays.copyOf(this.states, this.states.length);
+                count = i;
+            } else if (!hidden && positions != null) {
+                positions[count] = packed;
+                states[count] = this.states[i];
+                ++count;
+            }
+        }
+        if (positions == null) {
+            return this;
+        }
+        return count == 0 ? null : new ClientboundSectionBlocksUpdatePacket(this.sectionPos, java.util.Arrays.copyOf(positions, count), java.util.Arrays.copyOf(states, count));
+    }
+    // Canvas end - visibility anticheat
 
 
